[Unit]
Description=ProofGate Hermes WhatsApp gateway
After=network-online.target axcas-tool-bridge.service
Wants=network-online.target
Requires=axcas-tool-bridge.service

[Service]
Type=simple
User=proofgate
Group=proofgate
Environment=HOME=/home/proofgate
WorkingDirectory=/home/proofgate
Environment=AXCAS_BRIDGE_SOCKET=/run/axcas/tool-bridge.sock
EnvironmentFile=/etc/proofgate/hermes-gateway.env
ExecStart=/usr/local/bin/hermes gateway run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/home/proofgate
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target

[Unit]
Description=ProofGate named Cloudflare Tunnel
After=network-online.target proofgate-hermes-origin.service
Wants=network-online.target
Requires=proofgate-hermes-origin.service

[Service]
Type=simple
User=proofgate
Group=proofgate
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --token-file /etc/proofgate/cloudflared-token
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target

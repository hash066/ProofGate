{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "proofgate-whatsapp-growth",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "CONVEX_URL": "https://tame-corgi-404.convex.cloud",
    "META_GRAPH_API_VERSION": "v26.0",
    "SITE_VERIFIER_URL": "https://axcas-site-verifier.proofgate-harshita.workers.dev"
  },
  // Optional future backend: bind PROOFGATE_ASSETS to an R2 bucket after R2 is activated.
  // With no binding, private immutable media is stored in Convex File Storage.
  "kv_namespaces": [
    { "binding": "PROOFGATE_CONFIG", "id": "bfed66f79c9a4e66adf345f4dce3c113" }
  ]
}

{
  "name": "proofgate",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "scripts": {
    "demo": "tsx scripts/demo-loop.mjs",
    "intake": "tsx scripts/intake.mjs",
    "proofgate": "tsx apps/proofgate-cli/src/index.ts",
    "reel:render": "tsx scripts/render-reel.mjs",
    "reel:template:render": "npm run render --workspace=@axcas/reel-template-worker --",
    "acceptance:preflight": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/acceptance-preflight.mjs",
    "aws:deploy": "powershell -NoProfile -ExecutionPolicy Bypass -File infra/aws/deploy.ps1",
    "start": "node src/server.js",
    "dev:edge": "wrangler dev --config apps/edge-runtime/wrangler.jsonc",
    "deploy:spike-a": "wrangler deploy --config apps/edge-runtime/wrangler.jsonc --temporary",
    "verify:spike-a": "tsx apps/verifier-runner/src/spike-a.ts",
    "spike:b:dispatch": "tsx apps/spike-b-dispatcher/src/run.ts",
    "test:legacy": "node --test tests/integration/server.test.js tests/unit/booking.test.js",
    "test:unit": "vitest run --exclude='tests/**/*.test.js'",
    "test:hermes-plugin": "python tests/hermes_plugin_test.py",
    "test": "npm run test:legacy && npm run test:unit && npm run test:hermes-plugin",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@axcas/reel-template-worker"
  },
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1104.0",
    "@aws-sdk/client-secrets-manager": "^3.1109.0",
    "@aws-sdk/client-sqs": "^3.1109.0",
    "convex": "^1.42.1",
    "hono": "^4.13.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260815.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16",
    "wrangler": "^4.124.0"
  }
}
